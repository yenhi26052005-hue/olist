        <mxCell id="d4" parent="1" style="shape=partialRectangle;whiteSpace=nowrap;html=1;left=0;right=0;fillColor=#F3F3F3;strokeColor=#333333;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#222222;" value="D4 | Lịch sử xử lý" vertex="1">
